# Anthropic Messages-API 호환 provider 설정.
# 복사해서 .env 로 만들거나 셸에서 직접 export 한 뒤 실행.

# 필수: API 키
ANTHROPIC_API_KEY=your-api-key

# 옵션: 호스트. 비우면 기본 Anthropic 호스트(api.anthropic.com) 사용.
# GLM Coding Plan:
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 모델 ID. 엔드포인트가 받아들이는 값으로.
#   GLM:        glm-5.2
#   Anthropic:  claude-opus-5
AGENT_MODEL=glm-5.2

# 옵션: MCP 서버 설정 파일(Claude-Desktop 형식). 비우면 MCP 미사용.
# { "mcpServers": { "echo": { "command": "/tmp/mcp-echo" } } }
# AGENT_MCP_CONFIG=./mcp.json

# 옵션: 컨텍스트 compaction 한도(토큰 추정). 0 또는 비우면 기본 50000.
# AGENT_MAX_CONTEXT_TOKENS=50000

# 옵션: 대화 세션 저장 경로(TUI /save /resume). 기본 .agentic/session.json
# AGENT_SESSION=.agentic/session.json

# 옵션: 설정 파일(JSON). system_prompt · model · max_context_tokens · disable_tools[].
# AGENT_CONFIG=./agentic.json

# 영속 권한 규칙은 <base>/.agentic/settings.json 에 둔다(환경변수 아님):
#   { "mode": "plan",            // plan: 상태를 바꾸는 도구 전부 거부
#                                // auto-edit: 파일 편집은 통과, 셸은 승인 요구
#                                // full-auto: 승인 요구 안 함
#     "deny_tools": ["run_command"],   // mode 보다 우선
#     "allow_tools": ["edit"] }        // deny 다음 우선
# TUI 는 규칙이 정하지 않은 도구에 대해 y/n 을 묻고, one-shot(agentic ask)은 실행한다.

# API backend: "anthropic" (default) 또는 "openai"
# GLM Coding Plan OpenAI 엔드포인트를 쓰려면:
#   AGENT_API=openai
#   ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# AGENT_API=anthropic

# 옵션: run_command(foreground) 타임아웃(초). 기본 120.
# 빌드·테스트·의존성 설치는 background=true 를 쓰는 편이 낫다.
# AGENT_COMMAND_TIMEOUT=120

# 옵션: openai backend 의 max_tokens 상한(초과 요청은 조용히 잘린다). 기본 8192.
# AGENT_OPENAI_MAX_TOKENS=8192

# 옵션: openai backend 가 stream_options.include_usage 를 보내지 않게 한다.
# 이 필드를 거부하는 OpenAI 호환 서버를 쓸 때만 1 로 설정. 끄면 /cost 가 비어 있다.
# AGENT_OPENAI_NO_STREAM_OPTIONS=1

# HAR 캡처: 기본 켜짐. 요청·응답 전문(에이전트가 읽은 파일 내용 포함)이
# ~/.agentic/hars/session-<timestamp>.har 에 평문으로 남는다. API 키는 마스킹되지만
# 소스 코드는 그대로 기록되므로 민감한 저장소에서는 끄는 것을 권장.
# AGENT_HAR_DISABLE=1
# AGENT_HAR_FILE=./session.har
